# ================================================================
# Конфигурация прокси-сервера GigaChat BFF
# ================================================================
# Скопируйте этот файл в .env и заполните реальными значениями.
#
# Чтобы получить ключ авторизации:
#  1. Зарегистрируйтесь на https://developers.sber.ru/studio
#  2. Создайте проект GigaChat API
#  3. Сгенерируйте "Авторизационные данные" (base64 от ClientID:ClientSecret)
#  4. Вставьте полученную строку в GIGACHAT_AUTH_KEY ниже.

# Base64(ClientID:ClientSecret) из личного кабинета Sber
GIGACHAT_AUTH_KEY=

# Область действия токена: GIGACHAT_API_PERS (физ.лица) или GIGACHAT_API_CORP (юр.лица)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель по умолчанию (GigaChat, GigaChat-Pro, GigaChat-Max, GigaChat-2 и т.д.)
GIGACHAT_MODEL=GigaChat

# Порт BFF-сервера
PORT=8787

# Отключить проверку самоподписанного сертификата Minicert Sber.
# Ставим "1" в dev-окружении, чтобы Node.js не падал на цепочке сертификатов.
NODE_TLS_REJECT_UNAUTHORIZED=0
